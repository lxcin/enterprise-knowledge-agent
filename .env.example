# Copy these settings into your shell or environment manager.
# The CLI reads process environment variables.
KNOWLEDGE_BASE_URL=https://api.deepseek.com
KNOWLEDGE_MODEL=deepseek-flash
KNOWLEDGE_API_KEY=

# Alternative for tests/run_live.py if KNOWLEDGE_API_KEY is empty:
# DEEPSEEK_API_KEY=

# Optional embeddings. Only used with --semantic.
# Choose api or local explicitly.
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# Explicit directory containing separately provisioned local weights.
EMBEDDING_MODEL_PATH=
# Set only if required by the chosen embedding model.
EMBEDDING_QUERY_PREFIX=
